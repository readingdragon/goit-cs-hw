import faker
from random import randint, choice
import psycopg2

NUMBER_USERS = 3
NUMBER_STATUS = 5
NUMBER_TASKS = 5

def generate_fake_data(number_users, number_status, number_tasks) -> tuple(): # type: ignore
    fake_users = []
    fake_status = []
    fake_tasks = []

    fake_data = faker.Faker()

    for _ in range(number_users):
        fake_users.append(fake_data.user_name())

    for _ in range(number_status):
        fake_status.append(fake_data.state())

    for _ in range(number_tasks):
        fake_tasks.append(fake_data.random_lowercase_letter())

    return fake_users, fake_status, fake_tasks

def prepare_data(users, status, tasks) -> tuple(): # type: ignore
    for_users = []
    for user in users:
        for_users.append((user, ))

    for_status = []

    for stat in status:
        for_status.append((stat, choice(posts), randint(1, NUMBER_USERS)))
    for_tasks = []
    for tsk in tasks:
        for_tasks.append((tsk, choice(posts), randint(1, NUMBER_TASKS)))

    return for_users, for_status, for_tasks

